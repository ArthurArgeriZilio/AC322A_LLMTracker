<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".DetalheActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaria"
        app:navigationContentDescription="@string/cd_voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationIconTint="@color/branco"
        app:title="@string/detalhe_titulo"
        app:titleTextColor="@color/branco"
        tools:title="GPT-4o" />

    <TextView
        android:id="@+id/erro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="Não achei esse modelo."
        tools:visibility="gone" />

    <ScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cabecalho"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icone"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_circulo"
                        android:contentDescription="@string/cd_icone_modelo"
                        android:padding="16dp"
                        android:src="@drawable/ic_modelo"
                        app:tint="@color/branco" />

                    <TextView
                        android:id="@+id/nome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/texto"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="GPT-4o" />

                    <TextView
                        android:id="@+id/provedor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp"
                        tools:text="OpenAI" />

                </LinearLayout>
            </FrameLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <TextView
                style="@style/Secao"
                android:text="@string/secao_sobre" />

            <TextView
                android:id="@+id/resumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/texto"
                android:textSize="16sp"
                tools:text="Uso bastante pra código e resumo." />

            <TextView
                style="@style/Secao"
                android:text="@string/secao_avaliacao" />

            <TextView
                android:id="@+id/avaliacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="16sp"
                tools:text="Nota 4,8 de 5" />

            <TextView
                style="@style/Secao"
                android:text="@string/secao_lancamento" />

            <TextView
                android:id="@+id/lancamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="16sp"
                tools:text="2024" />

            <TextView
                style="@style/Secao"
                android:text="@string/secao_notas" />

            <TextView
                android:id="@+id/notas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="16sp"
                tools:text="Fica melhor quando peço o passo a passo." />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_notas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_notas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_salvar_nota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/salvar_nota" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_favorito"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/marcar_favorito"
                app:icon="@drawable/ic_estrela_vazia" />

            <TextView
                android:id="@+id/mensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_mensagem"
                android:padding="12dp"
                android:textColor="@color/mensagem_texto"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Anotação atualizada."
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
